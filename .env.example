# ==========================================
# LLM Provider Configuration
# ==========================================
# Supported providers: openai, mistral, gemini
# Choose which LLM provider to use for content generation
llm_provider=openai

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
openai_api_key=your_openai_api_key_here

# Mistral AI Configuration
# Get your API key from: https://console.mistral.ai/api-keys/
mistral_api_key=your_mistral_api_key_here

# Google Gemini Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
gemini_api_key=your_google_api_key_here

# ==========================================
# Local LLM Configuration (Ollama)
# ==========================================
# Set to use local LLM instance running on your machine
# local_model_url=http://localhost:11434
# Available models: llama2, mistral, neural-chat, etc.
# local_llm_model=llama2

# ==========================================
# API Server Configuration
# ==========================================
# API host and port settings
API_HOST=0.0.0.0
API_PORT=8001
API_LOG_LEVEL=info

# ==========================================
# CORS Configuration
# ==========================================
# Comma-separated list of allowed origins
# Add frontend URLs here for development
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://localhost:3000,https://localhost:8000

# ==========================================
# Application Configuration
# ==========================================
PROJECT_NAME=Meeting Transcription Agent
ENVIRONMENT=development
